<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Internet 101</title>
  </head>
  <body>
    <h1>Enter the SECRET PASSWORD to become a member</h1>
    <form action="/secret" method="GET">
      <label for="secret"> Enter Password</label>
      <input
        id="secret-pw"
        name="secret-password"
        placeholder="Enter the secret code"
        type="text"
      />
      <button id="secret-btn" type="submit">Submit</button>
    </form>
  </body>
</html>
